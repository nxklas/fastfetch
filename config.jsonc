{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "auto",
    "color": {
      "1": "\u001b[36m",
      "2": "light_green"
    }
  },
  "display": {
    "separator": ": "
  },
  "modules": [
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "title",
      "format": "╭─\u001b[36m{1}\u001b[37m@\u001b[36m{2}\u001b[37m───────────────────────────────╮"
    },
    {
      "key": "│ \u001b[37m├─ \u001b[36mOS",
      "type": "os"
    },
    {
      "key": "│ \u001b[37m├─ \u001b[36mKernel",
      "type": "kernel"
    },
    {
      "key": "│ \u001b[37m├─ \u001b[36mUptime",
      "type": "uptime"
    },
    {
      "key": "│ \u001b[37m├─ \u001b[36mPackages",
      "type": "packages"
    },
    {
      "key": "│ \u001b[37m├─ \u001b[36mShell",
      "type": "shell"
    },
    {
      "key": "│ \u001b[37m├─ \u001b[36mTerminal",
      "type": "terminal"
    },
    {
      "key": "│ │  \u001b[37m╰─\u001b[36m Font",
      "type": "terminalfont"
    },
    {
      "key": "│ \u001b[37m╰─ \u001b[36mWM",
      "type": "wm"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────╯"
    },
    {
      "type": "break"
    },
    {
      "type": "custom",
      "format": "╭─\u001b[36mSpecs\u001b[37m────────────────────────────────────────╮"
    },
    {
      "key": "│ \u001b[37m├─ \u001b[36mCPU",
      "type": "cpu"
    },
    {
      "key": "│ \u001b[37m├─ \u001b[36mGPU",
      "type": "gpu",
      "format": "{1} {2}"
    },
    {
      "key": "│ │  \u001b[37m├─\u001b[36m Drvr",
      "type": "gpu",
      "format": "{3}"
    },
    {
      "key": "│ │  \u001b[37m├─\u001b[36m Disp",
      "type": "display",
      "format": "{1}x{2} @ {3} Hz"
    },
    {
      "key": "│ │  \u001b[37m╰─\u001b[36m Colr",
      "type": "colors",
      "symbol": "square"
    },
    {
      "key": "│ \u001b[37m├─ \u001b[36mMemory",
      "type": "memory"
    },
    {
      "key": "│ \u001b[37m╰─ \u001b[36mDisk",
      "type": "disk",
      "folders": ["/"]
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────╯"
    }
  ]
}
